# ===========================================
# ZenAI Backend - Environment Variables (Phase 145)
# ===========================================
# Copy this file to .env and fill in your values.
# Variables marked [REQUIRED] must be set for the backend to start.
# Variables marked [OPTIONAL] enable additional features.
#
# PRODUCTION STACK:
#   Database: Supabase (PostgreSQL with pgvector) - 4 schemas
#   Backend:  Railway
#   Frontend: Vercel
#   Cache:    Redis on Railway

# ===========================================
# Database [REQUIRED]
# ===========================================
# CRITICAL: Use port 6543 (Transaction Mode Pooler), NOT 5432 (Session Mode)
# Port 5432 = max ~1 connection, WILL crash with pool exhaustion
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ===========================================
# AI [REQUIRED]
# ===========================================
ANTHROPIC_API_KEY=sk-ant-api03-...

# Claude model (default: claude-sonnet-4-20250514)
# CLAUDE_MODEL=claude-sonnet-4-20250514
# MAX_TOKENS=4096

# ===========================================
# Authentication [REQUIRED]
# ===========================================
# Generate with: cd backend && npm run create-web-key
VITE_API_KEY=ab_live_...

# ===========================================
# Server [OPTIONAL]
# ===========================================
PORT=3000
NODE_ENV=development

# CORS origins (comma-separated). Defaults to localhost if unset.
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://yourdomain.com

# Production API URL (used for Swagger server config)
# API_URL=https://your-backend.up.railway.app

# ===========================================
# Redis Cache [OPTIONAL]
# ===========================================
# If not set, caching is disabled (app works without it)
# REDIS_URL=redis://default:password@host:6379

# ===========================================
# Web Search [OPTIONAL]
# ===========================================
# Brave Search API (privacy-first). Falls back to DuckDuckGo if unset.
# Free tier: 2000 requests/month at https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=BSA...

# ===========================================
# Code Execution Sandbox [OPTIONAL]
# ===========================================
# ENABLE_CODE_EXECUTION=true
# CODE_EXECUTION_TIMEOUT=30000
# CODE_EXECUTION_MEMORY_LIMIT=256m
# CODE_SANDBOX_DIR=/tmp/code-sandbox

# Provider: auto-detected (docker local, judge0 production)
# EXECUTOR_PROVIDER=docker

# Judge0 (required for production code execution)
# JUDGE0_API_KEY=your-rapidapi-key
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# ===========================================
# GitHub Integration [OPTIONAL]
# ===========================================
# Personal Access Token - scopes: repo, read:user, read:org
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...

# ===========================================
# Stripe (Billing + Business Manager) [OPTIONAL]
# ===========================================
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...          # Monthly Pro price ID
# STRIPE_PRO_YEARLY_PRICE_ID=price_...   # Yearly Pro price ID
# STRIPE_ENTERPRISE_PRICE_ID=price_...          # Monthly Enterprise price ID
# STRIPE_ENTERPRISE_YEARLY_PRICE_ID=price_...   # Yearly Enterprise price ID

# ===========================================
# Google Analytics 4 [OPTIONAL]
# ===========================================
# GA4_PROPERTY_ID=123456789
# GA4_API_SECRET=...
# GOOGLE_SERVICE_ACCOUNT_EMAIL=...@...iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# ===========================================
# Google Search Console [OPTIONAL]
# ===========================================
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# GOOGLE_REDIRECT_URI=https://your-backend.up.railway.app/api/business/connectors/google/callback
# GSC_SITE_URL=https://yourdomain.com

# ===========================================
# Email - Resend (Phase 38) [OPTIONAL]
# ===========================================
# RESEND_API_KEY=re_...
# RESEND_WEBHOOK_SECRET=whsec_...
# RESEND_DEFAULT_FROM=noreply@yourdomain.com

# ===========================================
# Memory Scheduler (HiMeS) [OPTIONAL]
# ===========================================
# CRON_TIMEZONE=Europe/Berlin
# CONSOLIDATION_SCHEDULE="0 2 * * *"
# DECAY_SCHEDULE="0 3 * * *"
# ENABLE_MEMORY_CONSOLIDATION=true
# ENABLE_MEMORY_DECAY=true

# ===========================================
# Google Maps (Phase 41) [OPTIONAL]
# ===========================================
# GOOGLE_MAPS_API_KEY=AIza...

# ===========================================
# Slack Integration [OPTIONAL]
# ===========================================
# SLACK_CLIENT_ID=...
# SLACK_CLIENT_SECRET=...
# SLACK_SIGNING_SECRET=...

# ===========================================
# Apple Sign In [OPTIONAL] — Required for App Store compliance
# App Store Guideline 4.8: must offer if any other social login is offered.
# Setup: https://developer.apple.com/account/resources/identifiers/list/serviceId
# 1. Create a Service ID (your web client_id, e.g. com.yourcompany.yourapp.web)
# 2. Configure Sign In with Apple, set redirect URL to: https://your-backend/api/auth/callback/apple
# 3. Create a key with Sign In with Apple capability — download the .p8 file
# APPLE_CLIENT_ID=com.yourcompany.yourapp.web
# APPLE_TEAM_ID=XXXXXXXXXX
# APPLE_KEY_ID=XXXXXXXXXX
# APPLE_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\nMHQC....\n-----END EC PRIVATE KEY-----"

# ===========================================
# Twitter / X OAuth 2.0 PKCE [OPTIONAL]
# ===========================================
# Required for Social Media Agent (Twitter publishing & OAuth account linking)
# Create app at: https://developer.twitter.com/en/portal/dashboard
# Note: TWITTER_ACCESS_TOKEN still used as fallback if no DB account exists
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=

# ===========================================
# LinkedIn OAuth 2.0 [OPTIONAL]
# ===========================================
# Required for Social Media Agent (LinkedIn publishing & OAuth account linking)
# Create app at: https://www.linkedin.com/developers/apps
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# ===========================================
# Application URLs [OPTIONAL]
# ===========================================
# Used for OAuth redirect URIs and cross-service links
# FRONTEND_URL=http://localhost:5173
# BACKEND_URL=http://localhost:3000

# ===========================================
# Security [OPTIONAL]
# ===========================================
# JWT signing key (auto-generated in dev if unset)
# Generate with: openssl rand -base64 64
# JWT_SECRET=

# AES-256 field-level encryption key (auto-generated in dev if unset)
# Generate with: openssl rand -hex 32
# ENCRYPTION_KEY=

# ===========================================
# Error Tracking - Sentry [OPTIONAL]
# ===========================================
# Sentry DSN for backend error tracking (errors logged to console if not set)
# SENTRY_DSN=

# ===========================================
# Logging [OPTIONAL]
# ===========================================
# LOG_LEVEL=info

# ===========================================
# AI Fallback Providers [OPTIONAL]
# ===========================================
# Mistral AI (cloud fallback between Claude and Ollama)
# MISTRAL_API_KEY=

# OpenAI (additional fallback)
# OPENAI_API_KEY=

# Ollama (local LLM inference)
# OLLAMA_URL=http://localhost:11434

# ===========================================
# Voice Services [OPTIONAL]
# ===========================================
# ElevenLabs TTS (falls back to Edge-TTS if unset)
# ELEVENLABS_API_KEY=

# Deepgram STT (falls back to Whisper if unset)
# DEEPGRAM_API_KEY=

# ===========================================
# OAuth Login Providers [OPTIONAL]
# ===========================================
# Google OAuth
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# GitHub OAuth
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Microsoft OAuth
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# ===========================================
# Notifications [OPTIONAL]
# ===========================================
# Discord webhook for alerts
# DISCORD_WEBHOOK_URL=

# ===========================================
# Observability [OPTIONAL]
# ===========================================
# Sentry error tracking (https://sentry.io)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_RELEASE=zenai-backend@1.0.0
# SENTRY_ENABLED=false

# OpenTelemetry (OTLP exporter)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com:4318
# OTEL_SERVICE_NAME=zenai-backend
