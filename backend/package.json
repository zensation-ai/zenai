{
  "name": "zenai-backend",
  "version": "1.0.0",
  "description": "ZenAI - Enterprise AI Platform by ZenSation Enterprise Solutions",
  "homepage": "https://zensation.ai",
  "main": "dist/main.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "prebuild": "rm -rf dist",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' tsc",
    "start": "node dist/main.js",
    "db:init": "ts-node src/scripts/init-db.ts",
    "benchmark": "ts-node src/scripts/benchmark.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "experiments": "jest --testPathPattern='experiments/' --verbose --forceExit --no-coverage",
    "experiments:pma": "jest --testPathPattern='experiments/pma-benchmark' --verbose --forceExit",
    "experiments:ablation": "jest --testPathPattern='experiments/ablation-study' --verbose --forceExit",
    "experiments:comparison": "jest --testPathPattern='experiments/competitive-comparison' --verbose --forceExit",
    "test:redis": "ts-node src/scripts/test-redis-v2.ts",
    "diagnose:redis": "ts-node diagnose-redis.ts",
    "test:supabase": "ts-node src/scripts/test-supabase.ts",
    "migrate:supabase": "ts-node src/scripts/migrate-to-supabase.ts",
    "create-ios-key": "ts-node scripts/create-ios-api-key.ts",
    "create-web-key": "ts-node scripts/create-web-api-key.ts",
    "generate-api-key": "ts-node generate-api-key.ts",
    "mcp:start": "ts-node src/mcp/server.ts",
    "test:integration": "jest --config jest.integration.config.js --forceExit",
    "security:audit": "ts-node scripts/security-audit.ts",
    "build:ldnoobw": "ts-node --transpile-only ../scripts/moderation/build-ldnoobw.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "seed:demo": "ts-node scripts/seed-demo-data.ts",
    "db:migrate": "ts-node src/db/migrate.ts",
    "db:migrate:status": "ts-node src/db/migrate.ts --status"
  },
  "keywords": [
    "ai",
    "voice-memo",
    "ollama",
    "mistral",
    "pgvector"
  ],
  "author": "Alexander Bering <alex@zensation.ai> (https://zensation.ai)",
  "license": "Apache-2.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "archiver": "^7.0.1",
    "@google-analytics/data": "^5.2.2",
    "@mistralai/mistralai": "^2.5.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^1.29.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-node": "^1.29.0",
    "@sentry/node": "^10.69.0",
    "@slack/bolt": "^4.7.3",
    "@supabase/supabase-js": "^2.112.0",
    "@types/mailparser": "^3.4.6",
    "@types/pdfkit": "^0.17.4",
    "@zenai/shared": "workspace:*",
    "@zensation/algorithms": "^0.3.4",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.3",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "google-auth-library": "^10.9.1",
    "googleapis": "^171.4.0",
    "helmet": "^8.3.0",
    "ical.js": "^2.2.1",
    "imapflow": "^1.6.5",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.9.14",
    "mammoth": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^8.0.11",
    "openai": "^6.49.0",
    "otplib": "^12.0.1",
    "papaparse": "^5.5.4",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "resend": "^6.18.1",
    "rrule": "^2.8.1",
    "stripe": "^20.3.1",
    "svix": "^1.99.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tsdav": "^2.3.1",
    "uuid": "^11.1.1",
    "ws": "^8.21.2",
    "zod": "^4.4.3"
  },
  "overrides": {
    "diff": "^8.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@swc/core": "^1.15.18",
    "@swc/jest": "^0.2.39",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/archiver": "^6.0.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cheerio": "^0.22.35",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.3",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint": "^9.39.2",
    "eslint-plugin-security": "^3.0.1",
    "jest": "^30.2.0",
    "supertest": "^7.2.2",
    "testcontainers": "^11.14.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
