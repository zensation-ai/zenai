# ===========================================
# ZenAI Backend - Production Environment
# ===========================================
# Copy this file to .env on your production server and fill in all values.
# Variables without defaults are REQUIRED for production.
#
# PRODUCTION STACK:
#   Database: PostgreSQL with pgvector (Supabase recommended)
#   Backend:  Railway / Docker / any Node.js host
#   Frontend: Vercel / any static host
#   Cache:    Redis (Railway / Docker / managed)

# ===========================================
# Database [REQUIRED]
# ===========================================
DATABASE_URL=postgresql://user:pass@host:5432/zenai

# ===========================================
# AI [REQUIRED]
# ===========================================
ANTHROPIC_API_KEY=sk-ant-...

# ===========================================
# Security [REQUIRED]
# ===========================================
# Generate with: openssl rand -base64 64
JWT_SECRET=

# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ===========================================
# Server [REQUIRED]
# ===========================================
NODE_ENV=production
PORT=3000

# CORS: comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://app.zensation.ai,https://zensation.ai

# ===========================================
# Redis [REQUIRED for full functionality]
# ===========================================
# Caching, BullMQ job queues, rate limiting
REDIS_URL=redis://host:6379

# ===========================================
# Error Tracking [STRONGLY RECOMMENDED]
# ===========================================
SENTRY_DSN=https://...@sentry.io/...

# ===========================================
# Email [OPTIONAL]
# ===========================================
# RESEND_API_KEY=re_...
# RESEND_WEBHOOK_SECRET=whsec_...
# RESEND_DEFAULT_FROM=noreply@yourdomain.com

# ===========================================
# Payments [OPTIONAL]
# ===========================================
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ===========================================
# Web Search [OPTIONAL]
# ===========================================
# Falls back to DuckDuckGo if unset
# BRAVE_SEARCH_API_KEY=BSA...

# ===========================================
# AI Fallbacks [OPTIONAL]
# ===========================================
# MISTRAL_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_URL=http://localhost:11434

# ===========================================
# Voice [OPTIONAL]
# ===========================================
# ELEVENLABS_API_KEY=
# DEEPGRAM_API_KEY=

# ===========================================
# OAuth Providers [OPTIONAL]
# ===========================================
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# ===========================================
# Application URLs [OPTIONAL]
# ===========================================
# Used for OAuth redirect URIs and cross-service links
# FRONTEND_URL=https://app.zensation.ai
# BACKEND_URL=https://api.zensation.ai
