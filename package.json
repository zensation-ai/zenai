{
  "name": "zenai",
  "version": "2.0.0",
  "private": true,
  "description": "ZenAI - Personal AI Operating System by ZenSation Enterprise Solutions",
  "author": "Alexander Bering <alex@zensation.ai> (https://zensation.ai)",
  "homepage": "https://zensation.ai",
  "license": "Apache-2.0",
  "engines": {
    "node": "20.x"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=zenai-frontend --filter=zenai-backend",
    "dev:desktop": "turbo run build --filter=@zenai/shared && turbo run dev --filter=zenai-frontend --filter=zenai-electron --parallel",
    "dev:electron": "turbo run dev --filter=zenai-electron",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=zenai-frontend --filter=zenai-backend",
    "build:electron": "turbo run build --filter=zenai-electron",
    "test": "turbo run test",
    "test:backend": "turbo run test --filter=zenai-backend",
    "test:frontend": "turbo run test --filter=zenai-frontend",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "typecheck": "turbo run typecheck",
    "check:circular": "madge --circular --extensions ts,tsx backend/src/ && madge --circular --extensions ts,tsx frontend/src/"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "cpu-features",
      "node-zopfli-es",
      "iltorb"
    ],
    "overrides": {
      "tar": ">=7.5.13",
      "esbuild": ">=0.25.0",
      "electron": ">=41.1.0",
      "@tootallnate/once": ">=3.0.1",
      "flatted": ">=3.4.2",
      "yauzl": ">=3.2.1",
      "undici": ">=7.24.0",
      "handlebars": ">=4.7.9",
      "brace-expansion": ">=5.0.5",
      "picomatch": ">=4.0.4",
      "nodemailer": ">=8.0.5",
      "axios": ">=1.15.0",
      "form-data": ">=2.5.4",
      "lodash": ">=4.18.1",
      "lodash-es": ">=4.18.1",
      "tough-cookie": ">=4.1.4",
      "@xmldom/xmldom": ">=0.9.10",
      "next": ">=15.5.15",
      "vite": ">=5.4.21 <6.0.0",
      "qs": ">=6.14.1",
      "protobufjs": ">=7.6.4",
      "follow-redirects": ">=1.16.0",
      "postcss": ">=8.5.12",
      "uuid": "^11.1.0",
      "path-to-regexp": ">=8.4.2",
      "express@^4>path-to-regexp": "0.1.13"
    }
  },
  "devDependencies": {
    "madge": "^8.0.0",
    "turbo": "^2.10.8"
  },
  "dependencies": {
    "docx": "^9.6.1",
    "exceljs": "^4.4.0",
    "next": "^16.2.3",
    "pdfmake": "^0.3.7",
    "pptxgenjs": "^4.0.1"
  }
}
