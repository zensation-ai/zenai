# .env.docker — copy to .env for docker-compose
# Required
DATABASE_URL=postgresql://zenai:zenai@db:5432/zenai
REDIS_URL=redis://redis:6379
ANTHROPIC_API_KEY=your_key_here
JWT_SECRET=change_me_in_production_min_32_chars

# Optional (features degrade gracefully without these)
BRAVE_SEARCH_API_KEY=
RESEND_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=
ELEVENLABS_API_KEY=
STRIPE_SECRET_KEY=
ENCRYPTION_KEY=

# App
NODE_ENV=production
PORT=3000
FRONTEND_URL=http://localhost:5173
# FRONTEND_URL controls CORS — no separate CORS_ORIGIN needed
